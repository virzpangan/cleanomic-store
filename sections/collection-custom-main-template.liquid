{% assign list = collection.metafields.custom.collection_list.value %}
{% assign breadcrums = linklists['collection-main'] %}
<div class="coll-main-banner">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="wrapper">
          <h2>Father's Day Event 2026</h2>
          <p>
            For The Dads Who Do It All: <b>20% Off Sitewide</b> with code <span class="pm-code">DAD20</span>. Apply code at checkout.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="coll-main-breadcrumbs">
  <div class="container">
    <div class="row">
      <div class="col-12 col-md-1">
        <ul>
          <li>Jump to:</li>
        </ul>
      </div>
      <div class="col-12 col-md-11">
        <div class="wrapper">
          <ul>
            {% for link in breadcrums.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
{% for item in list %}
  {% include 'collection-category-slider' %}
{% endfor %}
