<div class="item-wrapper">
    <div class="item-row header panel otp panel-active">
        <ul>
            <li>
                <span class="subs-title d-block">Buy 1 Get 1 FREE</span>
            </li>
            <li>
                <span class="price comprice"></span>
                <span class="price">$68.98</span>
            </li>
        </ul>
    </div>
  
    <div class="item-row details">
        <ul>
            <li>
                <span>Earthwash</span>
            </li>
            <li>
                <select name="select-scent" id="select-scent">
                    <option value="Scent Free">Scent Free</option>
                    <option value="Ocean Breeze">Ocean Breeze</option>
                </select>
            </li>
        </ul>
        <ul>
            <li>
                <span>Oxy Laundry Booster Tablets</span>
            </li>
            <li>
                <select name="select-type" id="select-type">
                    <option value="White">White</option>
                    <option value="Color Boost">Color Boost</option>
                </select>
            </li>
        </ul>
        <ul>
            <li>
                <span>Earthfresh Dryer Sheets</span>
            </li>
        </ul>
        <ul>
            <li>
                <span>Earthlover’s Stain Removal Kit</span>
            </li>
        </ul>
    </div>
    <div class="item-row">
        <button>
            <span>Add to Cart</span>
            <img src="https://cdn.shopify.com/s/files/1/0278/0240/2903/files/btn-loadv2.gif?v=1659359779" width="23.2"
                alt="">
        </button>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<script>
    window.addEventListener("DOMContentLoaded", () => {
        const otp = document.querySelector('.item-wrapper .otp');
        const btnAdd = document.querySelector('.item-wrapper button');
        btnAdd.addEventListener('click', () => {

            //loading animation
            btnAdd.firstElementChild.style.display = 'none';
            btnAdd.lastElementChild.style.display = 'block';

            let variant_id = 43750563610862;

            const scent = document.querySelector('#select-scent').value;
            const oxyType = document.querySelector('#select-type').value;

            //check variant selection
            if (scent == 'Ocean Breeze' && oxyType == 'Color Boost') {
                variant_id = 43750563643630;
            } else if (scent == 'Ocean Breeze' && oxyType == 'White') {
                variant_id = 43750563578094;
            } else if (scent == 'Scent Free' && oxyType == 'Color Boost') {
                variant_id = 43750563676398;
            } else if (scent == 'Scent Free' && oxyType == 'White') {
                variant_id = 43750563610862;
            }

            otp_purchase(variant_id);

        });
    });

    function otp_purchase(variant_id) {
        jQuery.ajax({
            type: "POST",
            url: '/cart/clear.js',
            data: '',
            dataType: 'json',
            success: function () {
                data = {
                    "items": [

                        {
                            "id": variant_id,
                            "quantity": 1
                        }

                    ]
                }
                jQuery.ajax({
                    type: 'POST',
                    url: '/cart/add.js',
                    data: data,
                    dataType: 'json',

                    success: function () {
                        window.location.href = '/checkout/'

                        setTimeout(() => {
                            const btnText = document.querySelector('.item-wrapper button span');
                            const btnImg = document.querySelector('.item-wrapper button img');
                            btnText.style.display = 'block';
                            btnImg.style.display = 'none';
                        }, "3000");

                    }
                });
            },
            error: function (XMLHttpRequest, textStatus) {
                /* error code */
            }
        });
    }

</script>