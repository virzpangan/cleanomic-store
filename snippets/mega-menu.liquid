<style>
  :root {
    --cream: #fbf8ef;
    --soft-cream: #f4efe2;
    --sage: #7f9f72;
    --sage-dark: #395f43;
    --sage-deep: #243d2f;
    --mint: #dfead8;
    --sand: #eadfcb;
    --text: #233529;
    --muted: #63715f;
    --border: rgba(35, 53, 41, 0.14);
    --shadow: 0 24px 60px rgba(36, 61, 47, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  .site-nav__item{
    position: static;
}

header.site-header {
    padding: 0;
}

.site-nav__link{
  padding:20px!important;
}

.site-nav--has-dropdown:hover .site-nav__dropdown, .is-focused>.site-nav__dropdown{
  display:none!important;
  visibility: hidden!important;
}

.site-nav--has-dropdown.is-focused>a, .site-nav--has-dropdown:hover>a{
  background:none!important;
}

  .mega-menu {
    position: absolute;
    left: 0;
    top: 103px;
    width: 100%;
    background: var(--cream);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
  }

  .has-mega:hover .mega-menu,
  .has-mega:focus-within .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 1;
  }

  .mega-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 38px 34px 34px;
    display: grid;
    grid-template-columns: repeat(4, minmax(130px, 1fr)) 1.25fr 1.25fr;
    gap: 30px;
  }

  .mega-column {
    padding-top: 6px;
  }

  .mega-column .cat-img{
    transition: transform 180ms ease, box-shadow 180ms ease;
    border-radius: 5px;
    margin-bottom: 10px;
  }
  
  .mega-column .cat-img:hover{
    transform: translateY(-3px);
  }
  .mega-column h3 {
    font-family: Lexend;
    margin: 0 0 16px;
    color: var(--sage-dark);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .mega-column a {
    font-family: Lexend;
    display: block;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.35;
    margin: 12px 0;
  }

  .mega-column a:hover {
    color: var(--sage-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mega-card {
    max-width: 235px;
    min-height: 260px;
    margin-right: 30px;
    border-radius: 5px;
    padding: 15px 20px;
    background: linear-gradient(145deg, var(--mint), #f8f5ea);
    color: var(--text);
    text-decoration: none;
    border: 1px solid rgba(57, 95, 67, 0.14);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .mega-card:hover {
    transform: translateY(-3px);
    text-decoration:none;
    {% comment %} box-shadow: 0 16px 34px rgba(36, 61, 47, 0.16); {% endcomment %}
  }

  .mega-card.soft {
    background: linear-gradient(145deg, var(--sand), #fffaf0);
  }

  .card-img{
      margin-block: 8px;
      border-radius: 5px;
  }

  .card-badge {
    align-self: flex-start;
    padding: 3px 8px;
    border-radius: 999px;
    background: #fff;
    color: var(--sage-dark);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-graphic {
    height: 82px;
    border-radius: 18px;
    margin: 18px 0;
    background:
      radial-gradient(circle at 24% 50%, rgba(57, 95, 67, 0.9) 0 16%, transparent 17%),
      radial-gradient(circle at 52% 42%, rgba(127, 159, 114, 0.85) 0 18%, transparent 19%),
      radial-gradient(circle at 76% 55%, rgba(234, 223, 203, 1) 0 20%, transparent 21%),
      rgba(255, 255, 255, 0.64);
  }

  .card-graphic.sheets {
    background:
      linear-gradient(110deg, rgba(255, 255, 255, 0.86) 0 28%, transparent 29%),
      linear-gradient(110deg, transparent 0 36%, rgba(255, 255, 255, 0.72) 37% 61%, transparent 62%),
      linear-gradient(110deg, transparent 0 68%, rgba(255, 255, 255, 0.62) 69% 88%, transparent 89%),
      var(--mint);
  }

  .mega-card h3 {
    font-family: Lexend;
    margin: 0 0 8px;
    color: var(--sage-deep);
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: normal;
    line-height: 1.05;
  }

  .mega-card p {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .card-link {
    color: var(--sage-dark);
    font-size: 14px;
    font-weight: 900;
  }

  .mega-footer {
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px 34px 30px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mega-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 5px;
    background: var(--sage-deep);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 900;
  }

  .mega-cta:hover{
    color: #fff;
  }

  .mega-cta.secondary {
    background: var(--mint);
    color: var(--sage-deep);
  }

  .mega-text-link {
    margin-left: auto;
    color: var(--sage-dark);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .mega-text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mobile-menu-btn {
    display: none;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--sage-deep);
    font-size: 28px;
    cursor: pointer;
  }

  .mega-bundle-slider{
      grid-column: span 2;
  }

  @media (max-width: 1020px) {
    .mega-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .nav-bar {
      min-height: 70px;
      padding: 0 20px;
      flex-wrap: wrap;
      gap: 0;
    }

    .mobile-menu-btn {
      display: block;
    }

    .main-nav,
    .nav-actions {
      display: none;
      width: 100%;
    }

    .main-nav.is-open,
    .nav-actions.is-open {
      display: flex;
    }

    .main-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 18px;
    }

    .nav-link {
      width: 100%;
      justify-content: space-between;
      padding: 17px 0;
      border-bottom: 1px solid var(--border);
    }

    .nav-actions {
      padding: 0 0 20px;
      justify-content: space-between;
    }

    .mega-menu {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      margin: 8px 0 18px;
      border-radius: 22px;
      background: var(--soft-cream);
    }

    .has-mega.is-open .mega-menu {
      display: block;
    }

    .mega-inner {
      padding: 22px;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .mega-footer {
      padding: 0 22px 22px;
      flex-direction: column;
      align-items: stretch;
    }

    .mega-text-link {
      margin-left: 0;
      text-align: center;
    }

    .mega-card {
      min-height: 220px;
    }
  }
</style>
