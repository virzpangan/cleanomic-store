{% assign list = collection.metafields.custom.collection_list.value %}
{% assign breadcrums = linklists.collection-main %}

{%- comment -%} Build CollectionPage + ItemList schema from the referenced sub-collections. {%- endcomment -%}
{%- assign schema_position = 0 -%}
{%- assign schema_items_json = "" -%}
{%- for item in list -%}
  {%- for sub_collection in collections -%}
    {%- if sub_collection.title == item -%}
      {%- assign schema_position = schema_position | plus: 1 -%}
      {%- capture schema_list_item -%}{"@type": "ListItem", "position": {{ schema_position }}, "url": "{{ shop.url }}{{ sub_collection.url }}", "name": {{ sub_collection.title | json }}}{%- endcapture -%}
      {%- if schema_items_json == "" -%}
        {%- assign schema_items_json = schema_list_item -%}
      {%- else -%}
        {%- assign schema_items_json = schema_items_json | append: "," | append: schema_list_item -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{% include 'collection-schema', item_list_json: schema_items_json, item_count: schema_position %}
<div class="coll-main-banner">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="wrapper">
                    <h2>Clean Home. <br>Clean Planet. </h2>
                    <p>Products to help you to change the world without changing your lifestyle.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="coll-main-breadcrumbs">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-1">
                <ul>
                    <li>Jump to:</li>
                </ul>
            </div>
            <div class="col-12 col-md-11">
                <div class="wrapper">
                    <ul>
                        {% for link in breadcrums.links %}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% for item in list %}
{% include 'collection-category-slider' %}
{% endfor %}