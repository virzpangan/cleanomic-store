{% if settings.show_breadcrumbs %}

  {% unless template.name == 'index' or template.name == 'cart' %}
  <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
    <a href="/" title="{{ 'general.breadcrumbs.home_link_title' | t }}">{{ 'general.breadcrumbs.home' | t }}</a>

    {% if template.name == 'product' %}

      {% if collection %}
        <span class="divider" aria-hidden="true">/</span>
        {% if collection.handle %}
          {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
          {{ collection.title | link_to: url }}
        {% endif %}
      {% endif %}
      <span class="divider" aria-hidden="true">/</span>
      <span class="breadcrumb--truncate">{{ product.title }}</span>

    {% elsif template.name == 'collection' and collection.handle %}

      <span class="divider" aria-hidden="true">/</span>

      {% if current_tags %}

        {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
        {{ collection.title | link_to: url }}

        <span class="divider" aria-hidden="true">/</span>

        {% for tag in current_tags %}
          {% include 'filter-out-custom-tags' %}

          <span>{{ tag }}</span>

          {% unless forloop.last %}
            <span>+</span>
          {% endunless %}

        {% endfor %}

      {% else %}
        <span>{{ collection.title }}</span>
      {% endif %}

    {% elsif template.name == 'blog' %}

      <span class="divider" aria-hidden="true">/</span>
      {% if current_tags %}
        {{ blog.title | link_to: blog.url }}
        <span class="divider" aria-hidden="true">/</span>
        <span>{{ current_tags | join: " + " }}</span>
      {% else %}
      <span>{{ blog.title }}</span>
      {% endif %}

    {% elsif template.name == 'article' %}

      <span class="divider" aria-hidden="true">/</span>
      {{ blog.title | link_to: blog.url }}
      <span class="divider" aria-hidden="true">/</span>
      <span>{{ article.title }}</span>

    {% elsif template.name == 'page' %}

      <span class="divider" aria-hidden="true">/</span>
     <span>{{ page.title }}</span>

    {% else %}

      <span class="divider" aria-hidden="true">/</span>
     <span>{{ page_title }}</span>

    {% endif %}
  </nav>

  {%- comment -%} BreadcrumbList JSON-LD mirroring the visual trail above. {%- endcomment -%}
  {%- assign bc_pos = 1 -%}
  {%- capture bc_items -%}{"@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": "{{ shop.url }}/"}{%- endcapture -%}
  {%- if template.name == 'product' -%}
    {%- if collection and collection.handle -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ collection.title | json }}, "item": "{{ shop.url }}/collections/{{ collection.handle }}"}{%- endcapture -%}
    {%- endif -%}
    {%- assign bc_pos = bc_pos | plus: 1 -%}
    {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ product.title | json }}, "item": "{{ shop.url }}{{ product.url }}"}{%- endcapture -%}
  {%- elsif template.name == 'collection' and collection.handle -%}
    {%- if current_tags -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ collection.title | json }}, "item": "{{ shop.url }}/collections/{{ collection.handle }}"}{%- endcapture -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ current_tags | join: " + " | json }}}{%- endcapture -%}
    {%- else -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}"}{%- endcapture -%}
    {%- endif -%}
  {%- elsif template.name == 'blog' -%}
    {%- if current_tags -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ blog.title | json }}, "item": "{{ shop.url }}{{ blog.url }}"}{%- endcapture -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ current_tags | join: " + " | json }}}{%- endcapture -%}
    {%- else -%}
      {%- assign bc_pos = bc_pos | plus: 1 -%}
      {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ blog.title | json }}, "item": "{{ shop.url }}{{ blog.url }}"}{%- endcapture -%}
    {%- endif -%}
  {%- elsif template.name == 'article' -%}
    {%- assign bc_pos = bc_pos | plus: 1 -%}
    {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ blog.title | json }}, "item": "{{ shop.url }}{{ blog.url }}"}{%- endcapture -%}
    {%- assign bc_pos = bc_pos | plus: 1 -%}
    {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ article.title | json }}, "item": "{{ shop.url }}{{ article.url }}"}{%- endcapture -%}
  {%- elsif template.name == 'page' -%}
    {%- assign bc_pos = bc_pos | plus: 1 -%}
    {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ page.title | json }}, "item": "{{ shop.url }}{{ page.url }}"}{%- endcapture -%}
  {%- else -%}
    {%- assign bc_pos = bc_pos | plus: 1 -%}
    {%- capture bc_items -%}{{ bc_items }},{"@type": "ListItem", "position": {{ bc_pos }}, "name": {{ page_title | json }}}{%- endcapture -%}
  {%- endif -%}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{{ bc_items }}]
}
</script>
  {% endunless %}

{% endif %}
