<script>
    window.addEventListener("DOMContentLoaded", () => {
        const sellingPlan = 3274244334;
        const variantId = new URL(window.location.href).searchParams.get("variant_id");
        const utmParam = window.location.search.substring(1);

        fetch('/cart/clear.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
            .then(() => fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: [
                        {
                            id: variantId,
                            quantity: 1,
                            selling_plan: sellingPlan
                        }
                    ]
                })
            }))
            .then(() => {
                window.location.href = '/checkout/?' + utmParam;
            })
            .catch(() => {
                /* error code */
            });
    });
</script>
