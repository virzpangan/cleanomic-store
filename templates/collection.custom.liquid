
<div class="custom-collection">
    <div class="banner">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="wrapper">
                        <h2>{{ collection.title }}</h2>
                        <p>{{ collection.description }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="product-list">
        <div class="container">
            <div class="row">
                {% for product in collection.products%}
                {% if product.id == 7881714565358 %}
                {% for variant in product.variants %}
                {% if variant.id == 43432473231598 %}
                {% assign bathroomkit_comprice = variant.compare_at_price | money %}
                {% assign bathroomkit_price = variant.price | money %}
                {% endif %}
                {% endfor %}
                {% endif %}
                <div class="col-md-6 col-lg-6 col-xl-4">
                    <div class="wrapper">
                        <figure>
                            <a href="{{ product.url }}">
                              <img src="{{ product.featured_image | img_url: '400x' }}"
                                alt="{{ product.featured_image.alt }}">
                            </a>
                            <a class="btn-shop" href="{{ product.url }}">Shop Now</a>
                        </figure>
                        <div style="display:none;" class="yotpo bottomLine" data-yotpo-product-id="{{ product.id }}">
                        </div>
                        <h5>{{product.title }}</h5>
                        <span>{% if product.id == 7881714565358 %}{{ bathroomkit_price }} from <span
                                style="text-decoration: line-through;">{{ bathroomkit_comprice }}</span>{% else
                            %}{% if product.compare_at_price > product.price_min %}{{ product.price_min | money }}
                            from
                            <span style="text-decoration: line-through;">{{ product.compare_at_price | money
                                }}</span>{%
                            else %}{{
                            product.price | money }}{% endif %}{% endif %}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>