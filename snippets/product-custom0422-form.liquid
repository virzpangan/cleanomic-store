{% capture form_id %}AddToCartForm-{{ section_id }}{% endcapture %}
{% form 'product', product, data-productid: product.id, id: form_id, class: 'product-single__form' %}

  {% unless product.options.size == 1 and product.variants[0].title == 'Default Title' %}
    {% for option in product.options_with_values %}
      {% if settings.variant_type == 'button' %}
        {% include 'variant-dropdown', section_id: section_id %}
      {% endif %}
    {% endfor %}
  {% endunless %}


  <select name="id" data-productid="{{ product.id }}" id="ProductSelect-{{ section_id }}" class="product-single__variants no-js">
    {% for variant in product.variants %}
      {% if variant.available %}
        <option {% if variant == product.selected_or_first_available_variant %}
          selected="selected" {% endif %}
          value="{{ variant.id }}">
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {% else %}
        <option disabled="disabled">
          {{ variant.title }} - {{ 'products.product.sold_out' | t }}
        </option>
      {% endif %}
    {% endfor %}
  </select>
<p style="display:none;margin-bottom:10px;" class="msg-variant-1"><strong>Ocean Breeze: </strong> A breathtaking fragrance that will have your clothes smelling amazing all day long.</p>
<p style="display:none;margin-bottom:10px;" class="msg-variant-2"><strong>Unscented: </strong>For those with more sensitive skin that may be irritated or don’t like their clothes to have a scent.</p>

  {% if settings.quantity_enable %}
    <div class="product__quantity product__quantity--{{ settings.variant_type }} js-qty">
      <label for="Quantity-{{ section_id }}">{{ 'products.product.quantity' | t }}</label>
      <input type="number" hidden="hidden" id="Quantity-{{ section_id }}" name="quantity" value="1" min="1" class="js-qty__fallback">
    </div>
  {% endif %}


  {%- assign enable_dynamic_buttons = false -%}
  {% if settings.enable_payment_button and template != 'product.preorder' %}
    {%- assign enable_dynamic_buttons = true -%}
  {% endif %}



<p style="display:none;" class="cn-made"><img src="{{ 'us-made.png' | asset_img_url: '64x' }}"/><span>Directly Ships From Our US Warehouse in 3-8 Days</span></p>
<hr class="hr--medium">
<!--- Recharge --->

<!--- Recharge --->

  {% if enable_dynamic_buttons %}
    <div class="payment-buttons">
      
  {% endif %}

  
    <button
      {% if product.empty? %}type="button"{% else %}type="submit"{% endif %}
      name="add"
      id="AddToCart-{{ section_id }}"
      class="{% if enable_dynamic_buttons %}btn--tertiary{% else %}btn{% endif %} btn--full btn--no-animate add-to-cart"
      {% unless current_variant.available %} disabled="disabled"{% endunless %}>
      <span style="background-image: url('https://cdn.shopify.com/s/files/1/0062/5793/4454/files/cart-2x.png');width: 35px;height: 35px;display: block;position: absolute;top: 6px;left: 5px;background-size: 35px 35px;"></span>
      <span id="AddToCartText-{{ section_id }}">
        {% if current_variant.available %}
          {% if template == 'product.preorder' %}
            {{ 'products.product.preorder' | t }}
          {% else %}
        	{% if product.id == 7515189903598 %}
        		GET YOUR EARTHWASH FOR $0.00 + $7.99 SHIPPING
        	{% else %}
            	{{ 'products.product.add_to_cart' | t }}
        	{% endif %}
          {% endif %}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </span>
    </button>

      
    {% if enable_dynamic_buttons %}

      {{ form | payment_button }}

    {% endif %}

  {% if enable_dynamic_buttons %}
    </div>
  {% endif %}


    <div id="VariantsJson-{{ section_id }}" class="hide" aria-hidden="true">
    {{ product.variants | json }}
  </div>

{% if product.id == 4613762318423 %}
<ul class="cn-sg">
    <li><img src="{{ '30days.png' | asset_img_url: 'master' }}" alt=""></li>
    <li style="padding-left:10px;">
        <h5>30 DAY SATISFACTION GUARANTEE</h5>
        <p>If you installed this and you don't feel fully clean after doing your business, then just contact us within 30 days.</p>
    </li>
</ul>
{% endif %}


{% endform %}
