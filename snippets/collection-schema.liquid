{%- comment -%}
  CollectionPage + ItemList JSON-LD for collection (product listing) pages.

  Params (all optional):
    item_list_json - pre-rendered, comma-separated ListItem JSON objects. Use
                     this when the items aren't collection.products (e.g. a hub
                     page that lists sub-collections). If omitted, the ItemList
                     is built from collection.products.
    item_count     - number of items represented in item_list_json. Required
                     when item_list_json is passed in.
{%- endcomment -%}
{%- unless item_list_json -%}
  {%- assign item_count = collection.products.size -%}
  {%- capture item_list_json -%}
    {%- for product in collection.products -%}
      {"@type": "ListItem", "position": {{ forloop.index }}, "url": "{{ shop.url }}{{ product.url }}", "name": {{ product.title | json }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endunless -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": "{{ shop.url }}{{ collection.url }}",
  {% if collection.description != blank %}"description": {{ collection.description | strip_html | json }},{% endif %}
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ item_count | default: 0 }},
    "itemListElement": [{{ item_list_json }}]
  }
}
</script>
