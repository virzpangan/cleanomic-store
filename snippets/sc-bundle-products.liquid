{% assign bundle_content = meta_bundle.bundle_content %}
{% if bundle_content != blank %}
<div class="sc-bundle-products">
    <div class="container">
        <div class="row">
            <div class="col-md-12 text-center">
                <h2>{{bundle_content.title}}</h2>
                <p>{{bundle_content.description}}</p>
            </div>
        </div>
        <div class="row">
            {% for kit in bundle_content.kit.title %}
            <div class="{% if bundle_content.kit.title.size > 4 %}col-md-3{% else %}col{% endif %}">
                <div class="wrapper">
                    <figure>
                        <img src="{{ bundle_content.kit.image[forloop.index0] }}" alt="">
                        <figcaption>{{ bundle_content.kit.title[forloop.index0] }}</figcaption>
                    </figure>
                    <p>{{ bundle_content.kit.description[forloop.index0] }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}