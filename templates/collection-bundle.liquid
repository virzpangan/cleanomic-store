<div class="custom-collection">
  <div class="banner">
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <div class="wrapper">
            <h2>{{ collection.title }}</h2>
            <p>{{ collection.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <hr />
  <div class="product-list">
    <div class="container">
      <div class="row">
        <div class="col-md-6 col-lg-6 col-xl-4">
          <div class="wrapper">
            <figure>
              <a href="">
                <img
                  src="https://cleanomic.com/cdn/shop/files/zbcut2_720x.jpg?v=1767163288"
                  alt=""
                >
              </a>
              <a class="btn-shop" href="{{ product.url }}">
                {%- if product.available %}Shop Now{% else %}Sold Out - Coming Soon{% endif -%}
              </a>
            </figure>
          </div>
          <h5>Laundry Kit</h5>
          <span>$19.99 </span>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
