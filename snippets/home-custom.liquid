{{ 'pages-style.css' | asset_url | stylesheet_tag }}
<div class="promo-banner"></div>
<div class="category">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        <div class="wrapper">
          <h2>Explore Our World</h2>
          <p>
            We find sustainable alternatives to everyday products so you can help the planet without sacrificing
            convenience.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12 p-0">
        <div class="slider-wrapper">
          {% assign col_items = collections | reverse %}
          {% for item in col_items %}
            {% if item.image %}
              <div>
                <figure style="background-image: url({{ item.image | img_url: 'master' }});">
                  <figcaption>
                    <span>{{ item.title }}</span>
                    <hr />
                    <a href="{{item.url}}">Shop All</a>
                  </figcaption>
                </figure>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
<div class="satisfaction">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <h2>130,000+ Happy Earth-Lovers</h2>
        <p>It’s easy to see why our mission for a planet-friendly home has gone global.</p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4">
        <div class="wrapper">
          {% render 'icon-efficient' %}
          <h4>Efficient. Effective. Convenient</h4>
          <p>Take care of your household needs without missing a step</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="wrapper">
          {% render 'icon-eco-friendly' %}
          <h4>Cleaner Ingredients</h4>
          <p>We avoid the harsh chemicals used by “big name” brands</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="wrapper">
          {% render 'icon-safe-ingredients' %}
          <h4>Sustainable Packaging</h4>
          <p>Solutions that are designed to help reduce plastic waste.</p>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="recommended">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12">
        <h2>A Few Fan Favorites</h2>
        <div class="slider-wrapper">
          {% for product in collections.frontpage.products %}
            {% assign mod = forloop.index | modulo: 2 %}
            {% if product.id == 7881714565358 %}
              {% for variant in product.variants %}
                {% if variant.id == 43432473231598 %}
                  {% assign bathroomkit_comprice = variant.compare_at_price | money %}
                  {% assign bathroomkit_price = variant.price | money %}
                {% endif %}
              {% endfor %}
            {% endif %}
            <div>
              <div style="{% if mod != 0 %}margin-top:60px;{% endif %}" class="panel">
                <figure>
                  {% if product.tags != blank %}
                    <span>{{ product.tags[0] }}</span>
                  {% endif %}
                  <a href="{{ product.url }}">
                    <img
                      src="{{ product.featured_image | img_url: '300x300' }}"
                      alt="{{product.featured_image.alt}}"
                    >
                  </a>
                  <a class="btn-shop" href="{{ product.url }}">Shop Now</a>
                </figure>
                <div style="display:none;" class="yotpo bottomLine" data-yotpo-product-id="4613762318423"></div>
                <h5>{{ product.title }}</h5>
                <span>
                  {%- if product.id == 7881714565358 -%}
                    {{- bathroomkit_price }} from
                    <span style="text-decoration: line-through;">{{ bathroomkit_comprice }}</span>
                  {%- else -%}
                    {{- product.price | money -}}
                  {%- endif -%}
                </span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
<div class="review">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="slider-wrapper">
          <div>
            <div class="wrapper text-center">
              <h5>What Customers are Saying</h5>
              <p>
                “I've tried a couple other brands, but they seemed to fall flat. I never felt like they were getting my
                clothes clean. This product created lots of suds, so I knew it was in there. I felt that the clothes
                were clean when I pulled them out of the washer. I'm VERY happy with this product...”
              </p>
              <span>— Jen G.</span>
            </div>
          </div>
          <div>
            <div class="wrapper text-center">
              <h5>What Clients are Saying</h5>
              <p>
                “Do Earth a favor and get a great product. It's a win-win. This is my third purchase of these sheets and
                I really hope they never go out of business because I love everything about them. They clean my clothes
                better than big commercial brands... SO easy to use! I can't say that enough...”
              </p>
              <span>— Patty</span>
            </div>
          </div>
          <div>
            <div class="wrapper text-center">
              <h5>What Clients are Saying</h5>
              <p>
                “This is a great new way to use detergent… I will continue to buy them from now on. Get rid of all those
                big plastic containers and use these sheets. They work great. One sheet for my regular load and
                everything is clean.”
              </p>
              <span>— Carol</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="about">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <div class="wrapper">
          {% render 'icon-logo-dark' %}
          <h2>
            Better For You <br>
            Better For The Planet
          </h2>
          <p>
            We offer convenient alternatives to everyday single use plastic home goods. With the end goal to make the
            earth a cleaner, better place.
          </p>
          <a href="./collections/catalog/">Explore Now</a>
        </div>
      </div>
      <div class="col-md-6 img-bg p-0">
        <img
          src="https://cdn.shopify.com/s/files/1/0278/0240/2903/files/kitchen-cleaning.jpg?v=1656834687"
          alt=""
        >
      </div>
    </div>
  </div>
</div>
<script>
  $(document).on('ready', function () {
    $('.banner .slider-wrapper-desktop').slick({
      dots: true,
      arrows: false,
      autoplay: true,
      autoplaySpeed: 3000,
      fade: true,
    });
    $('.category .slider-wrapper').slick({
      slidesToShow: 4,
      slidesToScroll: 1,
      speed: 300,
      arrows: true,
      infinite: false,
      variableWidth: true,
      responsive: [
        {
          breakpoint: 960,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: false,
            variableWidth: true,
          },
        },
      ],
    });
    $('.recommended .slider-wrapper').slick({
      slidesToShow: 3,
      slidesToScroll: 1,
      speed: 300,
      arrows: true,
      infinite: false,
      variableWidth: true,
      responsive: [
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: false,
            variableWidth: true,
          },
        },
      ],
    });
    $('.review .slider-wrapper').slick({
      dots: true,
      arrows: false,
      autoplay: true,
      autoplaySpeed: 5000,
      fade: true,
    });
  });
</script>
