<script>
  const menuButton = document.querySelector(".mobile-menu-btn");
  const mainNav = document.querySelector(".main-nav");
  const navActions = document.querySelector(".nav-actions");
  const megaParent = document.querySelector(".has-mega");
  const megaToggle = megaParent.querySelector(".nav-link");

  menuButton.addEventListener("click", () => {
    mainNav.classList.toggle("is-open");
    navActions.classList.toggle("is-open");
  });

  megaToggle.addEventListener("click", (event) => {
    if (window.innerWidth <= 900) {
      event.preventDefault();
      megaParent.classList.toggle("is-open");
    }
  });
</script>

<script>
    $(document).on('ready', function () {
        $('.mega-bundle-slider').slick({
