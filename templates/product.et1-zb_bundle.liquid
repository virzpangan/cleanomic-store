{% assign target_collection = collections['et1-zipbag-bundle-2'] %}

<script>
    document.addEventListener("DOMContentLoaded", () => {
        var sp_index = 0;

        //Generate Thumbnails
        generateThumb();

        //Select Frequency
        const frequencyItem = document.querySelectorAll('.list-frequency li');
        frequencyItem.forEach((item, index) => {
            item.addEventListener('click', () => {
                removeActive(frequencyItem);
                item.classList.add('active');
                sp_index = index;
            });
        });

        //Add to cart
        const btnAddToCart = document.querySelector("#addtocart");
        btnAddToCart.addEventListener('click', () => {
            btnAddToCart.classList.add("loading");
            //checkout process
            checkoutItems(sp_index);
            //send cart event
            sendGTMEvent();
            //remove animation
            setTimeout(() => {
                btnAddToCart.classList.remove("loading");
            }, 8000);

        });

    });

    async function checkoutItems(sp_index) {
        try {
            // Optional: clear cart
            await fetch('/cart/clear.js', { method: 'POST' });

            // Add item + attributes
            await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: getItemList(sp_index),
                    attributes: getUrlParams()
                })
            });

            window.location.href = '/checkout/';
        } catch (err) {
            console.error('Cart error:', err);
            window.location.href = '/cart';
        }
    }

    function getItemList(index){
        const lastVariantsWithPlans = [
        {% for product in target_collection.products %}
        {% assign v = product.variants.last %}
        {
            product_id: {{ product.id }},
            variant_id: {{ v.id }},
            selling_plans: [
            {% for spa in v.selling_plan_allocations %}
                {
                selling_plan_id: {{ spa.selling_plan.id }},
                selling_plan_name: {{ spa.selling_plan.name | json }},
                price_adjustments: {{ spa.price_adjustments | json }}
                }{% unless forloop.last %},{% endunless %}
            {% endfor %}
            ]
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
        ];
        
        let lineItem = [];
        lastVariantsWithPlans.forEach(product =>{
            if(product.variant_id === 45234914394350){
                lineItem.push({
                id: product.variant_id,
                quantity: 1,
                selling_plan: product.selling_plans[index].selling_plan_id
            });
            }else{
                lineItem.push({
                id: product.variant_id,
                quantity: 1
            });
            }
        });
        console.log('items: ', lineItem);
        return lineItem;
    }

    
    function sendGTMEvent() {
        // Define dataLayer and the gtag function.
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }

        //Google Consent Mode v2
        gtag('consent', 'update', {
            'ad_storage': 'granted',
            'analytics_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted',
        });

        const event = {
            "cartLine": {
                "cost": {
                    "totalAmount": {
                        "amount": 99,
                        "currencyCode": "USD"
                    }
                },
                "merchandise": {
                    "id": "45234914394350",
                    "image": {
                        "src": "https://cdn.shopify.com/s/files/1/0278/0240/2903/files/zbcut2.jpg?v=1767163288"
                    },
                    "price": {
                        "amount": 99,
                        "currencyCode": "USD"
                    },
                    "product": {
                        "id": "7772568289518",
                        "title": "Cleanomic Trash Bag Bundle",
                        "vendor": "Cleanomic",
                        "type": "",
                        "untranslatedTitle": "Cleanomic Trash Bag Bundle",
                        "url": "/products/cleanomic-trash-bag-bundle?selling_plan=5219385582&variant=45234914394350"
                    },
                    "sku": "CC-FTBKRK09-06",
                    "title": "Free Trash Bags For Life (Kitchen V4)",
                    "untranslatedTitle": "Free Trash Bags For Life (Kitchen V4)"
                },
                "quantity": 1
            }
        }

        const id =
            event.cartLine?.merchandise?.id ||
            event.cartLine?.merchandise?.sku ||
            event.cartLine?.merchandise?.product?.id;
        const content_ids = id ? [parseInt(id)] : [];
        const content_type =
            event.cartLine?.merchandise?.id || event.cartLine?.merchandise?.sku ? 'product' : 'product_group';
        const content_name = getContentNameFilterOutDefault(
            event.cartLine?.merchandise?.product?.title,
            event.cartLine?.merchandise?.title
        );
        const content_category = event.cartLine?.merchandise?.product?.type || 'Kitchen';
        const currency = event.cartLine?.merchandise?.price?.currencyCode || 'USD';
        const value = event.cartLine?.merchandise?.price?.amount;
        const num_items = event.cartLine?.quantity || 1;

        window.dataLayer.push({
            event: "champEvent",
            id: '',
            champEventLabel: "AddToCart",
            champOrderId: '',
            champTotal: value,
            champRedTrackSum: "false",
            champCustomTracker: "true",
            champMetaData: {
                eventName: "AddToCart",
                eventId: event.id,
                eventMetaData: {
                    content_ids,
                    content_type,
                    content_name,
                    content_category,
                    currency,
                    value,
                    num_items
                }
            }, champUserData: {
                em: '',
                ph: '',
                fn: '',
                ln: '',
                ct: '',
                st: '',
                zp: '',
                country: '',
            }
        });
    }


    function getUrlParams() {
        const params = new URLSearchParams(window.location.search);
        const attributes = {};

        // Convert all URL params into cart attributes
        for (const [key, value] of params.entries()) {
            if (value) {
                attributes[key] = value;
            }
        }
        return attributes;
    }

        function removeActive(elem) {
        elem.forEach((item) => {
            if (item.classList.contains('active')) {
                item.classList.remove('active');
                return;
            }
        });
    }

    function generateThumb() {
        const slides = document.querySelectorAll('#slick-slide00 img, #slick-slide01 img, #slick-slide02 img, #slick-slide03 img, #slick-slide04 img, #slick-slide05 img');
        const thumbs = document.querySelectorAll('.slick-dots li button');

        for (i = 0; i <= slides.length - 1; i++) {
            thumbs[i].style.backgroundImage = `url(${slides[i].src})`;
        }
    }

</script>



